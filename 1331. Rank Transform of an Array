class Solution {
public:
    vector<int> arrayRankTransform(vector<int>& arr) {
        set<int> unique_sorted(arr.begin(), arr.end());
        unordered_map<int, int> rank_map;
        int rank = 1;
        for (int num : unique_sorted) {
            rank_map[num] = rank;
            rank++;
        }
        vector<int> result;
        result.reserve(arr.size());
        for (int num : arr) {
            result.push_back(rank_map[num]);
        }
        
        return result;
    }
};
