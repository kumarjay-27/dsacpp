class Solution {
public:
    string smallestSubsequence(string s) {
        vector<int> count(26, 0);
        vector<bool> seen(26, false);
        string result = "";
        for (char c : s) {
            count[c - 'a']++;
        }
        for (char c : s) {
            count[c - 'a']--; 

            if (seen[c - 'a']) continue; 
            while (!result.empty() && result.back() > c && count[result.back() - 'a'] > 0) {
                seen[result.back() - 'a'] = false;
                result.pop_back();
            }
            result.push_back(c);
            seen[c - 'a'] = true;
        }
        return result;
    }
};
