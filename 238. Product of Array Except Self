class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {
        int pro=1;
        int ct=0;
        int n=nums.size();
        vector<int>answer(n,0);
        for(int m:nums){
            if(m==0) ct++;
            else pro=pro*m;
        }
        for(int i=0;i<n;i++)
        {
            if(ct==0){
                answer[i]=(pro/nums[i]);
            }
            else if(ct==1 && nums[i]==0){
                answer[i]=pro;
            }
        }
        return answer;
    }
};
