class Solution {
public:
    int numberOfSpecialChars(string word) {
        unordered_set<char>low ,upp;
        for(char ch:word){
            if(islower(ch)){
                low.insert(ch);
            }
            else{
                upp.insert(tolower(ch));
            }
        }
        int c=0;
        for(char ch:low){
            if(upp.count(ch)) c++;
        }
        return c;
    }
};
