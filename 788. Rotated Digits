class Solution {
public:
    int rotatedDigits(int n) {
       int res = 0;

        for (int i = 1; i <= n; i++) {
            int num = i;
            bool isValid = true;
            bool hasRotatedChange = false;

            while (num > 0) {
                int digit = num % 10;
                if (digit == 3 || digit == 4 || digit == 7) {
                    isValid = false;
                    break;
                }
                if (digit == 2 || digit == 5 || digit == 6 || digit == 9) {
                    hasRotatedChange = true;
                }
                
                num /= 10;
            }
            if (isValid && hasRotatedChange) {
                res++;
            }
        }
        return res;
    }
};
